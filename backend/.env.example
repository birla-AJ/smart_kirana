DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/nimad_kirana"

# App
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# JWT
JWT_ACCESS_SECRET="CHANGE_ME_ACCESS_SECRET"
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET="CHANGE_ME_REFRESH_SECRET"
JWT_REFRESH_EXPIRES_IN=30d

# OTP
OTP_LENGTH=6
OTP_EXPIRES_IN_MINUTES=5
OTP_RESEND_SECONDS=30
OTP_MAX_ATTEMPTS=5

# MSG91 (SMS)
MSG91_AUTH_KEY=""
MSG91_TEMPLATE_ID=""
MSG91_SENDER_ID="NIMKIR"

# Bcrypt
BCRYPT_SALT_ROUNDS=10

# Razorpay
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Email (Nodemailer)
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Nimad Kirana <no-reply@nimadkirana.com>"

# Firebase (Push Notifications)
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# AWS S3 (File Storage)
AWS_REGION="ap-south-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET="nimad-kirana-assets"
AWS_S3_PUBLIC_BASE_URL=""